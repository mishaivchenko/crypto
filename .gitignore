frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
monitor-app/npm-debug.log*
monitor-app/yarn-debug.log*
monitor-app/yarn-error.log*
monitor-app/pnpm-debug.log*

